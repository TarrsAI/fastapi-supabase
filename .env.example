# Auto-injected by Tarrs into the dev sandbox.
SUPABASE_URL=

# Anon (public) key — used by the per-request user-scoped Supabase
# client (`get_supabase_as`) so RLS sees `auth.uid()` and policies
# fire as if the user themselves were querying. Required for the
# RLS-driven /posts routes; if you only use the admin client, you
# can leave this blank (the dep will raise a clear error if you try
# to scope a query without it).
SUPABASE_ANON_KEY=

# Service-role key — bypasses RLS. Used by `get_supabase_admin()` for
# server-owned mutations (system jobs, materialized refreshes, admin
# endpoints). NEVER ship to a browser. The exception handler avoids
# echoing 5xx error.message to clients, but the key itself must stay
# server-side.
SUPABASE_SERVICE_ROLE_KEY=

# JWT verification secret. We verify the Bearer token on every request
# using this. Find at Supabase project: Settings → API → JWT Settings.
SUPABASE_JWT_SECRET=

# Anthropic — used by the example /api/chat SSE agent. Add via Tarrs
# Settings → Sandbox secrets, or paste into .env locally.
ANTHROPIC_API_KEY=

# CORS — comma-separated origins (e.g. https://yourapp.com). Empty
# disables cross-origin requests entirely. Never set to "*" with
# credentials.
CORS_ORIGINS=

# Log level (info/debug/warning). Defaults to info.
LOG_LEVEL=info

PORT=8080
